# Copiá este archivo como .env y completá los valores.
# El .env NO se sube a ningún lado ni se comparte: tiene la clave.

# Proveedor del modelo: deepseek | openai | anthropic
PROVEEDOR=deepseek

# La clave del proveedor que elegiste arriba.
# Si falta, el servicio no arranca — a propósito.
API_KEY=

# Desde qué dominio se acepta el chat. Sin barra al final.
ORIGEN=https://nexoiarg.com

# Puerto interno. Nginx le habla acá; no se expone a internet.
# El 3001 lo usa precios.nexoiarg.com, el 3010 ventas24 y el 5678 n8n.
PUERTO=3020
